<?xml version="1.0" encoding="utf-8"?>
<!--
    The icon's background plate, lifted from the psBg gradient in photo-sweep.svg
    (#101828 → #080C14, top-left to bottom-right). Kept as a vector rather than a bitmap so
    it stays crisp at every mask size and costs nothing in the APK.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF101828"
                android:endColor="#FF080C14" />
        </aapt:attr>
    </path>
</vector>
